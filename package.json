{
  "name": "papertrade-alerts",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial self-hostable alerting service for Papertrade (papertrade.xyz): a Cloudflare Worker with Cron Triggers and D1 that watches wallets and the protocol and notifies Telegram, Discord and signed webhooks.",
  "license": "Apache-2.0",
  "author": "nirholas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "build:site": "esbuild ui/app.ts --bundle --format=esm --minify --target=es2022 --sourcemap --outfile=public/app.js",
    "dev:site": "npm run build:site && wrangler d1 migrations apply papertrade-alerts --local && wrangler dev --port 8796 --test-scheduled",
    "deploy:site": "npm run build:site && wrangler d1 migrations apply papertrade-alerts --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply papertrade-alerts --local",
    "db:migrate:remote": "wrangler d1 migrations apply papertrade-alerts --remote",
    "telegram:webhook": "node scripts/set-telegram-webhook.mjs"
  },
  "keywords": [
    "papertrade",
    "hyperliquid",
    "hyperevm",
    "alerts",
    "telegram",
    "discord",
    "webhook",
    "cloudflare-workers",
    "d1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/papertrade-alerts.git"
  },
  "homepage": "https://github.com/nirholas/papertrade-alerts#readme",
  "bugs": {
    "url": "https://github.com/nirholas/papertrade-alerts/issues"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "papertrade-sdk": "file:../papertrade-sdk-0.1.0.tgz",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
